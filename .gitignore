# ---------------------------------------------------------------------------
# kafka-one-stop-lab — Node.js + KafkaJS + Docker Compose (KRaft) lab
# ---------------------------------------------------------------------------

# --- Node / npm ------------------------------------------------------------
node_modules/
jspm_packages/
.npm
.yarn/cache
.yarn/unplugged
.pnpm-store/
.node_repl_history
*.tgz

# Logs produced by package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# NOTE: package-lock.json is intentionally NOT ignored.
# This is a private application, so the lockfile must be committed for
# reproducible installs (`npm ci`).

# --- Secrets / local configuration ----------------------------------------
# .env holds broker endpoints and (in production variants) SASL credentials.
# Keep .env.example tracked as the documented template.
.env
.env.*
!.env.example

# Kafka TLS / SASL material — never commit these
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.truststore
secrets/
certs/

# --- Docker / Kafka local state -------------------------------------------
# Broker data lives in named volumes (kafka1-data ...), but bind-mounted or
# hand-rolled local runs drop these directories into the repo.
docker-compose.override.yml
docker-compose.*.local.yml
kafka-data/
kafka-logs/
kraft-combined-logs/
data/
volumes/

# --- Test / coverage output ------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml
.node-test-*

# --- Build / cache artifacts ----------------------------------------------
dist/
build/
out/
.cache/
tmp/
temp/
*.tsbuildinfo
.eslintcache

# --- Runtime logs & crash dumps -------------------------------------------
logs/
*.log
*.heapsnapshot
core.*
pids/
*.pid
*.seed
*.pid.lock

# --- Editors / IDEs --------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~

# --- OS noise --------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows (primary dev platform for this lab)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
.directory
.Trash-*
